{
  "threshold": 0,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/antlr_parser/**",
    "**/grammar/**",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/__testUtils__/**",
    "**/coverage/**",
    "**/docs/**"
  ],
  "minLines": 6,
  "minTokens": 50,
  "format": ["typescript", "javascript"]
}
