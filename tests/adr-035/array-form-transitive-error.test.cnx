// test-error
// test-adr: 035
// ADR-035, E0866/E0876/E0892 across two includes: each 1.2 array-form rule in each
// context, on a declaration that uses names from a file the included file includes. The dimension
// LIMIT and the array source are declared there; the rules are decided here,
// at the declaration's own position. The element count is the
// array-count-transitive-error fixture's, since 1.2 errors stop 2.1.
#include "array-init-chain.cnx"

// NEGATIVE CONTROLS -- a sized fill-all and a list, both sized by LIMIT.
u8[LIMIT] okFill <- [0*];
u8[LIMIT] okList <- [1, 2, 3];

// ASSERTIONS -- a global variable.
u8[] globalFill <- [LIMIT*];
u8[2] globalCopy <- source;
u8[][LIMIT] globalRows <- [[1, 2, 3]];

void main() {
    // ASSERTIONS -- a function local. Its copy of `source` is a negative
    // control: inside a function another array is copied in (#1209).
    u8[] localFill <- [LIMIT*];
    u8[2] localCopy <- source;
    u8[][LIMIT] localRows <- [[1, 2, 3]];
}

scope Table {
    // ASSERTIONS -- a scope member.
    u8[] memberFill <- [LIMIT*];
    u8[2] memberCopy <- source;
    u8[][LIMIT] memberRows <- [[1, 2, 3]];

    public void fill() {
        // ASSERTIONS -- a scope-method local; its copy, as a function local's.
        u8[] methodFill <- [LIMIT*];
        u8[2] methodCopy <- source;
        u8[][LIMIT] methodRows <- [[1, 2, 3]];
    }
}
