#include <stdio.h>

mut string<50> userName;

u32 main(string args[]) {
    (void)printf("What is your name in 50 characters or less? ");

    // ADR-046: c_ prefix required for nullable C pointers
    cstring c_result <- fgets(userName, userName.size, stdin);
    if (c_result != NULL) {
        if (userName.value_char_count > 0 && userName[userName.value_char_count - 1] = '\n') {
            userName[userName.value_char_count - 1] <- '\0';
        }
    }

    u8 whoAmIByte <- (u8)args[0][0];

    (void)printf("Hello from %s %s! Your special character is %c\n", args[0], userName, whoAmIByte);

    return 0;
}
