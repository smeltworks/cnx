// Test: Basic scoped register declaration and access

scope Teensy4 {
    public register GpioPort {
        0x00 rw u32 DR,
        0x84 wo u32 DR_SET,
        0x8C wo u32 DR_TOGGLE,
    }

    public GpioPort GPIO7(0x42004000);
}

void main() {
    // Access scoped register
    Teensy4.GPIO7.DR_SET <- 8;
}
