#pragma target cortex-m7
// Test: Bit indexing on scoped registers

scope Board {
    u32 LED_BIT <- 3;

    register GpioPort {
        0x00 rw u32 DR,
        0x84 wo u32 DR_SET,
    }

    GpioPort GPIO(0x40000000);

    public void toggleLed() {
        // Simpler test: direct access
        Board.GPIO.DR_SET[3] <- true;
    }
}

void main() {
    Board.toggleLed();
    Board.GPIO.DR[0] <- true;
}
