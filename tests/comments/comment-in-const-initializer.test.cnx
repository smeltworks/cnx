#pragma target cortex-m7
// Tests: a comment inside a const initializer never reaches the C (#1991 review)
// A block comment, and a line comment that splits the initializer over lines
scope Board {
    u32 BASE <- (0x40000000 /* GPIO block */);
    u32 SPLIT <- (0x40000000 + // GPIO block
        0x100);
    register GpioPort {
        0x00 rw u32 DATA,
    }

    GpioPort Gpio(BASE);
    register PortPins {
        0x00 rw u32 DATA,
    }

    PortPins Pins(SPLIT);
}

void main() {
    Board.Gpio.DATA <- 1;
    Board.Pins.DATA <- 2;
}
