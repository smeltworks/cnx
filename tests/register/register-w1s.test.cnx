// test-coverage: 12-w1s-access-modifier
#pragma target cortex-m7
// Tests: Write-1-to-Set register access modifier
// Writing 1 to a bit sets it, writing 0 has no effect
register GpioPort {
    0x00 rw u32 DR,
    0x84 w1s u32 DR_SET, // Write-1-to-set
    0x88 w1c u32 DR_CLEAR, // Write-1-to-clear
    0x8C wo u32 DR_TOGGLE,
}

GpioPort GPIO(0x40000000);

register ControlBlock {
    0x00 w1s u32 ENABLE, // Write-1-to-set enable bits
    0x04 w1s u32 FLAGS, // Write-1-to-set flags
}

ControlBlock CTRL(0x40001000);

void setGpioBit(u8 pin) {
    GPIO.DR_SET[pin] <- true; // Set specific pin
}

void setGpioMask(u32 mask) {
    GPIO.DR_SET <- mask; // Set multiple pins
}

void enableFeature(u8 feature) {
    CTRL.ENABLE[feature] <- true;
}

void setFlags(u32 flagMask) {
    CTRL.FLAGS <- flagMask;
}

void main() {
    // Set individual GPIO pins
    setGpioBit(0);
    setGpioBit(7);
    setGpioBit(15);

    // Set multiple GPIOs at once
    setGpioMask(0x00FF); // Set pins 0-7

    // Enable features
    enableFeature(0);
    enableFeature(3);

    // Set multiple flags
    setFlags(0x0F); // Set flags 0-3
}
