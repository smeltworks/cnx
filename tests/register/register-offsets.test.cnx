#pragma target cortex-m7
// ADR-004: Register offset calculation test
// Tests: correct offset values in generated C macros
register UartPort {
    0x00 rw u32 CR,
    0x04 ro u32 SR,
    0x08 rw u32 DR,
    0x0C rw u32 BRR,
    0x10 rw u32 CR1,
}

UartPort UART(0x40001000);

void main() {
    UART.CR <- 0x01;
    UART.DR <- 0x55;
    UART.BRR <- 9600;
    UART.CR1 <- 0x80;

    u32 status <- UART.SR;
}
