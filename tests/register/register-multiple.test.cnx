// ADR-004: Multiple registers in same file
// Tests: defining and using multiple register blocks
register GpioPort {
    0x00 rw u32 DR,
    0x04 rw u32 GDIR,
}

GpioPort GPIOA(0x40020000);

GpioPort GPIOB(0x40020400);

register Timer {
    0x00 rw u32 CR,
    0x04 ro u32 CNT,
}

Timer TIMER(0x40000000);

void main() {
    // Configure GPIO A as output
    GPIOA.GDIR <- 0xFF;
    GPIOA.DR <- 0x01;

    // Configure GPIO B as input
    GPIOB.GDIR <- 0x00;
    u32 input <- GPIOB.DR;

    // Read timer count
    u32 count <- TIMER.CNT;
}
