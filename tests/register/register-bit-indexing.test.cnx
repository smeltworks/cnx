#pragma target cortex-m7
// ADR-004 + ADR-007: Bit indexing on registers
// Tests: single bit access on register members
register GpioPort {
    0x00 rw u32 DR,
    0x84 wo u32 DR_SET,
}

GpioPort GPIO(0x40000000);

void main() {
    // Set single bit
    GPIO.DR[0] <- true;
    GPIO.DR[7] <- true;

    // Read single bit
    bool bit3 <- GPIO.DR[3];

    // Write to set register bit
    GPIO.DR_SET[4] <- true;
}
