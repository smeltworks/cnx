// test-error
// A global variable and a scope with the same name are two file-level
// definitions of one name: E0425, like `u8 LED <- 5;` declared twice (#1805).
// test-adr: 057

u8 LED <- 5; // Global variable named same as scope

scope LED {
    public mut u8 brightness <- 100;

    public void on() {
        brightness <- 255;
    }
}

scope Motor {
    public u32 test() {
        u8 val <- global.LED; // Access global variable (5)
        LED.on(); // Access scope function
        // MISRA: get brightness into variable first
        u8 bright <- LED.brightness;
        // Need to return u32, so cast the sum
        mut u32 result <- val;
        result +<- bright;
        return result; // 5 + 255 = 260
    }
}

u32 main() {
    u32 result <- Motor.test();
    if (result != 260) {
        return 1;
    }
    return 0;
}
