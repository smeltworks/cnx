// test-error
// #1726 review: a loop certainly runs only when its condition tests the
// variable its init set to zero, so here the update may never run and x is
// read uninitialized after the loop.
u32 skipped() {
    mut u32 x;
    u32 j <- 5;
    for (u32 i <- 0; j < 3; x <- 1) {}
    return x;
}

// `i +<- 0` adds zero to i, it does not set i to zero: pick(5) never enters
// the loop, so x is read uninitialized.
u32 pick(u32 start) {
    mut u32 i <- start;
    mut u32 x;
    for (i +<- 0; i < 3; i +<- 1) {
        x <- 7;
    }
    return x;
}
