// test-execution
// test-link: cjson_api.c ../../libs/cJSON/cJSON.c
// Tests: cJSON object/array construction through ADR-061 C boundary layer
// Issue #931: Real-world library integration tests

#include "cjson_api.h"
// #1881: cJSON is named here, so cJSON.h is included here
#include "../../libs/cJSON/cJSON.h"

u32 main() {
    string<32> rpmKey <- "rpm";
    string<32> samplesKey <- "samples";
    i32[3] samples <- [1000, 1250, 1500];

    mut cJSON root <- global.cjson_api_create_object();
    mut cJSON rpm <- global.cjson_api_create_number(1250.0);
    mut cJSON sampleArray <- global.cjson_api_create_int_array(samples, 3);

    bool addedRpm <- global.cjson_api_add_item_to_object(root, rpmKey, rpm) != 0;
    bool addedSamples <- global.cjson_api_add_item_to_object(root, samplesKey, sampleArray) != 0;
    if (addedRpm = false) {
        global.cjson_api_delete(root);
        return 1;
    }
    if (addedSamples = false) {
        global.cjson_api_delete(root);
        return 2;
    }

    cJSON savedRpm <- global.cjson_api_get_object_item(root, rpmKey);
    i32 savedRpmValue <- global.cjson_api_get_valueint(savedRpm);
    if (savedRpmValue != 1250) {
        global.cjson_api_delete(root);
        return 3;
    }

    cJSON savedSamples <- global.cjson_api_get_object_item(root, samplesKey);
    i32 sampleCount <- global.cjson_api_get_array_size(savedSamples);
    if (sampleCount != 3) {
        global.cjson_api_delete(root);
        return 4;
    }

    cJSON finalSample <- global.cjson_api_get_array_item(savedSamples, 2);
    i32 finalValue <- global.cjson_api_get_valueint(finalSample);
    if (finalValue != 1500) {
        global.cjson_api_delete(root);
        return 5;
    }

    mut char jsonText <- global.cjson_api_print_unformatted(root);
    string<64> expectedJson <- "{\"rpm\":1250,\"samples\":[1000,1250,1500]}";
    bool jsonMatches <- global.cjson_api_string_equals(jsonText, expectedJson) != 0;
    if (jsonMatches = false) {
        global.cjson_api_free_string(jsonText);
        global.cjson_api_delete(root);
        return 6;
    }

    global.cjson_api_free_string(jsonText);
    global.cjson_api_delete(root);
    return 0;
}
