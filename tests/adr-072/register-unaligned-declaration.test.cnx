// test-execution
// test-adr: 072
#pragma target cortex-m7
// ADR-072 ruling 13: alignment (E0939) is a hardware map's rule. A register
// with no fixed-address instance that no parameter takes, like Part 4's J1939
// frame, may place a u16 at an odd offset.

register Etc1 {
    0 ro u8 control,
    1 ro u16 outputShaft,
    3 ro u8 clutchSlip,
    5 ro u16 inputShaft,
}

void main() {}
