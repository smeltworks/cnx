// test-error
// test-adr: 072
// ADR-072, E0931: a register instance's address is resolved at compile time.
// A `mut` base can change at run time, so it cannot fix an instance's address.

register GpioPort {
    0x00 rw u32 DR,
}

mut u32 base <- 0x401B8000;

GpioPort GPIO1(base);

// Negative control: a constant base is an address
u32 FIXED <- 0x401BC000;
GpioPort GPIO2(FIXED + 0x10);

void main() {
    GPIO1.DR <- 1;
    GPIO2.DR <- 1;
}
