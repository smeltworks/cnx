// test-error
// test-adr: 072
#pragma target cortex-m7
// ADR-072, E0942: a scoped register instance read whole names its type as
// cnx spells it (`Board.Port`), not as C does.

scope Board {
    public register Port {
        0x00 rw u32 DR,
    }

    public Port P1(0x40000000);
}

void main() {
    u32 x <- Board.P1;
}
