// test-error
// test-adr: 072
#pragma target cortex-m7
// ADR-072, E0931 and E0932: an address or offset that folds to a negative
// number has no hexadecimal spelling and is no hardware address.

i32 BACK <- -4;

register Port {
    BACK rw u32 DR,
}

Port P1(0 - 0x10);

scope Board {
    register Latch {
        BACK rw u32 Q,
    }
}

void main() {
    P1.DR <- 1;
}
