// test-error
// test-adr: 072
// ADR-072, E0933: a register parameter is specialized per instance at compile
// time. Until that is implemented it is rejected, never passed as a pointer.

register GpioPort {
    0x00 rw u32 DR,
}

GpioPort GPIO1(0x401B8000);

void setHigh(GpioPort port) {
}

void main() {
    GPIO1.DR <- 1;
}
