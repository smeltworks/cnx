// test-error
// test-adr: 072
#pragma target cortex-m7
// ADR-072, E0934: a register instance names hardware at a fixed address for
// the whole program, so it is declared at file or scope level, not as a local.

register GpioPort {
    0x00 rw u32 DR,
}

void main() {
    GpioPort LOCAL(0x40000000);
}
