// test-error
// test-adr: 072
// ADR-072, E0933 and E0934 for a register type declared in a scope, written
// bare, as this.T and as Scope.T.

scope Board {
    public register Port {
        0x00 rw u32 DR,
    }

    public Port P1(0x40000000);

    public void bare(Port p) {}

    public void viaThis(this.Port p) {}

    public void local() {
        Port LOCAL(0x40001000);
    }
}

void qualified(Board.Port p) {}

void main() {
    Board.P1.DR <- 1;
}
