// Issue #380: String array initializers
// Tests: const string array with inline initialization

// Array of bounded strings with initializer (C-style allowed for string arrays)
string<10>[3] LABELS <- ["One", "Two", "Three"];

// Non-const string array with initializer
string<8>[4] colors <- ["Red", "Green", "Blue", "Yellow"];

scope Test {
    public void init() {
        // Access string array element
        u32 len <- global.LABELS[0].value_char_count;
    }
}

u32 main() {
    // Test 1: LABELS array should have 3 elements
    if (global.LABELS.type_element_count != 3) {
        return 1;
    }

    // Test 2: Check LABELS string lengths
    if (global.LABELS[0].value_char_count != 3) {
        return 2; // "One"
    }
    if (global.LABELS[1].value_char_count != 3) {
        return 3; // "Two"
    }
    if (global.LABELS[2].value_char_count != 5) {
        return 4; // "Three"
    }

    // Test 3: colors array should have 4 elements
    if (global.colors.type_element_count != 4) {
        return 5;
    }

    // Test 4: Check colors string lengths
    if (global.colors[0].value_char_count != 3) {
        return 6; // "Red"
    }
    if (global.colors[1].value_char_count != 5) {
        return 7; // "Green"
    }
    if (global.colors[2].value_char_count != 4) {
        return 8; // "Blue"
    }
    if (global.colors[3].value_char_count != 6) {
        return 9; // "Yellow"
    }

    // Test 5: Exercise scope function
    global.Test.init();

    return 0;
}
