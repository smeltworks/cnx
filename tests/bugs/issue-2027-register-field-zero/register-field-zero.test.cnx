// test-error
// test-adr: 004
#pragma target cortex-m7
// Issue #2027: a zero written to a field of a write-1 register member is
// E0872, as the same bit written by index is. Every spelling of the register
// is checked, and a one, an rw member and a nonzero range are controls that
// must stay silent.

bitmap8 Pins {
    A,
    B,
    C,
    LED,
    Mode[3],
    R7
}

register GpioPort {
    0x00 wo Pins DR_SET,
    0x04 w1c Pins STATUS,
    0x08 w1s Pins SET,
    0x0C rw Pins DATA,
}

GpioPort GPIO(0x40000000);

bool OFF <- false;

scope Drive {
    register PwmChannel {
        0x00 w1c Pins FLAGS,
        0x04 wo Pins CTRL,
    }

    PwmChannel PWM(0x40001000);

    public void viaBare() {
        PWM.FLAGS.LED <- false;
        PWM.CTRL.Mode <- 0;
        PWM.FLAGS.LED <- true;
    }

    public void viaThis() {
        this.PWM.FLAGS.LED <- false;
    }
}

void go() {
    GPIO.DR_SET.LED <- false;
    GPIO.DR_SET.LED <- 0x0;
    GPIO.DR_SET.LED <- OFF;
    GPIO.STATUS.LED <- false;
    GPIO.SET.LED <- false;
    GPIO.DR_SET.Mode <- 0;
    Drive.PWM.CTRL.Mode <- 0;
    global.GPIO.STATUS.LED <- false;
    GPIO.DR_SET.LED <- true;
    GPIO.DR_SET.Mode <- 5;
    GPIO.DATA.LED <- false;
}
