// test-execution
// Issue #1881 negative control: main includes buf-size.h itself as well as
// lib/mid.cnx, so its header carries the include from its own list.
#include "lib/buf-size.h"
#include "lib/mid.cnx"

mut u8[BUF_SIZE] x;

u32 main() {
    x[0] <- 1;
    if (x[0] != 1) {
        return 1;
    }
    u32 got <- count();
    if (got != 8) {
        return 2;
    }
    return 0;
}
