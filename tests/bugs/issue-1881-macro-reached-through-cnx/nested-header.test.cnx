// test-execution
// Issue #1881: C includes are textual, so a header main includes brings in
// the headers it includes. LED is lib/board.h's own; PIN is lib/pins.h's,
// which board.h includes, as is its pin_t. All are defined here.
#include "lib/board.h"

u32 main() {
    u32 led <- LED;
    pin_t pin <- PIN;
    if (led != 13) {
        return 1;
    }
    if (pin != 3) {
        return 2;
    }
    return 0;
}
