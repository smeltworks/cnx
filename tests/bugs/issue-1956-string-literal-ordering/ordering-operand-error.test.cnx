// test-error
// test-adr: 045
// #1956: a string is ordered only with a string, and an ordering of strings is not chained
#pragma target host
u32 n <- 3;
bool flag <- true;
string<4> a <- "ab";
string<4> b <- "cd";
string<4> c <- "ef";

void main() {
    bool r1 <- a < n;
    bool r2 <- n >= "ab";
    bool r3 <- a <= flag;
}
