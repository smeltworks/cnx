// test-execution
// test-no-warnings
// test-link: dev_impl.c
// The cross-file form of `struct-field` (#1744): `Motor` is declared in an
// included `.cnx`, so this file sees its opaque-handle field only through that
// file's generated header.
//
// Not marked `test-adr: 030`, like #1722's cross-file fixture: the matrix
// would credit what it records to the `direct` row through this file's include
// depth (#1402), an occupancy that would move when #1402 is fixed.
#include "dev.h"
#include "motors.cnx"

i32 main() {
    mut Motor m;
    m.d <- dev_create();
    m.speed <- 9;

    dev_poke(m.d);
    spinMotor(m);
    i32 pokes <- dev_pokes(m.d);
    if (pokes != 2) {
        return 1;
    }
    if (m.speed != 9) {
        return 2;
    }

    return 0;
}
