// test-execution
// test-no-warnings
// test-link: full_cb_impl.c
// A cnx function registered with a C callback typedef takes the typedef's
// shape (#895): its `Full` parameter is a `Full*` in C AND in C++, because a C
// function pointer cannot take a C++ reference. Member access honored that --
// `f->pokes` in both modes -- but a whole-value use asked the MODE instead of
// the parameter, and C++ rendered the pointer itself: `Full copy = f;`, which
// g++ rejects as a conversion from `Full*` to `Full`. The transpiler exited 0.
//
// Control: a function NOT registered with the typedef keeps ADR-006 reference
// semantics, so in C++ its parameter is a `const Full&` and a whole-value use
// stays the bare name.
#include "full_cb.h"

void onFull(mut Full f) {
    Full copy <- f;
    f.pokes <- copy.pokes + 10;
}

u32 plainSnapshot(Full f) {
    Full copy <- f;
    return copy.pokes;
}

i32 main() {
    mut Full f <- { pokes: 1 };
    global.full_register(onFull);
    global.full_invoke(f);
    if (f.pokes != 11) {
        return 1;
    }

    u32 snapshot <- plainSnapshot(f);
    if (snapshot != 11) {
        return 2;
    }

    return 0;
}
