// test-execution
// #2063: a callback parameter whose type name begins with `const`
// (`constraint_t`) is not const, so a `mut constraint_t` callback matches `Cb`.

#include "api.h"

void onConstraint(mut constraint_t c) {
    c.v <- 1;
}

u32 main() {
    global.register_cb(onConstraint);
    mut constraint_t c;
    c.v <- 0;
    global.run_cb(c);
    if (c.v != 1) {
        return 1;
    }
    return 0;
}
