// test-error
// #1668: E0881 types a bitmap variable with the one operand typer and reads
// every assignment site. Before, a scope's bitmap variable -- its type
// spelled `this.Flags` -- was never recognized as a bitmap, and a write in a
// `for` header was never checked (#1726).
scope Motor {
    bitmap8 Flags {
        Mode[3],
        Enable[1],
        Reserved[4]
    }

    mut this.Flags f <- 0;

    public void run() {
        // NEGATIVE CONTROL -- a value that fits the field
        this.f.Mode <- 7;
        // ASSERTION
        this.f.Mode <- 8;
    }
}

bitmap8 Global {
    Mode[3],
    Enable[1],
    Reserved[4]
}

mut Global g <- 0;

void main() {
    Motor.run();
    // NEGATIVE CONTROL
    for (mut u32 i <- 0; i < 3; g.Mode <- 7) {
        i +<- 1;
    }
    // ASSERTION
    for (mut u32 j <- 0; j < 3; g.Mode <- 8) {
        j +<- 1;
    }

    // #1726: the same writes as a `for` init, and a field the bitmap does not
    // have in each form
    mut u32 k <- 0;
    for (g.Mode <- 7; k < 3; k +<- 1) {}
    for (g.Mode <- 8; k < 6; k +<- 1) {}
    g.Nope <- 1;
    for (mut u32 n <- 0; n < 3; g.Nope <- 1) {
        n +<- 1;
    }
    for (g.Nope <- 1; k < 9; k +<- 1) {}
}
