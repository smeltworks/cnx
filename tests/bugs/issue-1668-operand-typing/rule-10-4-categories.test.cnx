// test-error
// test-adr: 024
// #1668 (ADR-024, owner rulings): E0810's categories are MISRA C:2012 Rule
// 10.4's -- signed, unsigned, floating, Boolean, character, and each named
// enum as its own. A suffixed literal has its suffix's category (R2); an
// unsuffixed one has none, but a character literal is essentially
// character (owner ruling, strict MISRA). `+` may combine a character with an
// integer. A comparison with an enum operand is E0434's (ADR-017), not E0810's.
enum Color {
    RED,
    GREEN
}

void main() {
    u32 a <- 1;
    i32 s <- 1;
    Color c <- Color.RED;
    u8 ch <- 65;
    bool b <- true;

    // NEGATIVE CONTROLS -- no category, the same category, MISRA's exception.
    u32 ok1 <- a + 5;
    i32 ok2 <- s + 5i32;
    i32 ok2r <- 5i32 + s;
    u32 ok3 <- a + 'A';
    bool ok4 <- ch = (u8)'A';
    bool ok5 <- c = Color.GREEN;
    // Not E0810's: E0434 owns it, and runs after E0810, which stops here.
    bool ok6 <- a = c;

    // ASSERTIONS
    u32 e1 <- a + 5i32;
    u32 e2 <- 5i32 + a;
    // An enum under `+` and a char under `*` are Rule 10.1's (E0925), which
    // runs first (#1191), so these mix them where the operator takes them
    u32 e3 <- (b = true) ? a : c;
    u32 e4 <- a - 'A';
    bool e5 <- ch = 'A';
    bool e6 <- a = b;
}
