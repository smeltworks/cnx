// test-execution
// Tests: a private scope const named in a scope variable's initializer is a
// C constant expression there (C99 6.7.8p4), whatever its type -- a char
// literal and a header macro included
#include "limit.h"

enum EMode {
    IDLE,
    RUN
}

scope S {
    bool EN <- true;
    bool flag <- EN;
    f32 HALF <- 1.0 / 2.0;
    f32 twice <- HALF * 2.0;
    EMode D <- EMode.RUN;
    EMode mode <- D;
    bool A <- true;
    bool B <- A;
    bool copied <- B;
    u8 CH <- (u8)'A';
    u8 first <- CH;
    u32 FROM_MACRO <- LIMIT;
    u32 fromMacro <- FROM_MACRO;

    public u32 check() {
        if (flag != true) {
            return 1;
        }
        if (twice != 1.0) {
            return 2;
        }
        if (mode != EMode.RUN) {
            return 3;
        }
        if (copied != true) {
            return 4;
        }
        if (first != 65) {
            return 5;
        }
        if (fromMacro != 10) {
            return 6;
        }
        return 0;
    }
}

u32 main() {
    u32 r <- S.check();
    return r;
}
