// test-execution
// Control for E0925: fully indexed elements and struct fields are numbers

#pragma target host

u32 main() {
    mut u8[2][3] grid;
    grid[0][1] <- 4;
    grid[1][2] <- 5;
    u8 sum <- grid[0][1] + grid[1][2];
    if (sum != 9) {
        return 1;
    }
    if ((grid[0][1] < grid[1][2]) = false) {
        return 2;
    }
    return 0;
}
