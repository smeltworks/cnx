// test-error
// #1798, #1772: a float is not an integer -- shift and bitwise operators take integers only,
// and so do their compound assignments

u32 f(f32 k) {
    u32 a <- k << 1;
    u32 b <- k >> 2;
    u32 c <- k & 1;
    u32 d <- ~k;
    u32 e <- 1 << k;
    u32 g <- k | 1;
    u32 h <- k ^ 1;
    return a + b + c + d + e + g + h;
}

void compound() {
    mut f32 k <- 1.0;
    k <<<- 1;
    mut u32 u <- 1;
    u <<<- 1;
}
