// test-execution
// test-adr: 045
// #1373 controls: a two-operand string comparison, and a chain whose operands are all bool, stay legal
#pragma target host

i32 main() {
    string<8> a <- "x";
    string<8> b <- "x";
    string<8> c <- "y";
    bool p <- true;
    bool q <- false;
    bool r <- false;
    if (a != b) {
        return 1;
    }
    if (a = c) {
        return 2;
    }
    bool differ <- a != c;
    if (differ != true) {
        return 3;
    }
    bool same <- p = q = r;
    if (same != true) {
        return 4;
    }
    bool apart <- p != q != r;
    if (apart != true) {
        return 5;
    }
    return 0;
}
