// test-error
// test-adr: 024
// #1373: a < b < c is (a < b) < c, a bool under < (MISRA 10.1), as the parenthesized form already is, once per chain
#pragma target host

i32 main() {
    i32 a <- 1;
    i32 b <- 2;
    i32 c <- 3;
    i32 d <- 4;
    if (a < b < c) {
        return 1;
    }
    if (a < b < c < d) {
        return 2;
    }
    return 0;
}
