// test-error
// test-cpp-only
// test-adr: 070
// Tests: a member template leaves a call unjudged only when it can take the
// call's arguments (#2473 review). `Tg::get` has a template of two
// arguments, so `tg.get(1)` reaches the u32 method alone and discards its
// result. `tg.get(1, 2)`, `tg.any(1)`, `tg.two(1)` and `tg.late(1)` can reach
// a template -- packs take any number, and a trailing return type hides its
// count -- so they are not judged. `Tg::cv`'s template ends in a C `...`,
// which still needs its one parameter: `tg.cv()` reaches the u32 method
// alone, while `tg.cv(1)` can reach the template.
#include "lib/cpp-tpl.hpp"

mut Tg tg;

void main() {
    // NEGATIVE CONTROLS -- each stays silent.
    (void)tg.get(1);
    tg.get(1, 2);
    tg.any(1);
    tg.two(1);
    tg.late(1);
    tg.cv(1);

    // ASSERTIONS
    tg.get(1);
    tg.cv();
}
