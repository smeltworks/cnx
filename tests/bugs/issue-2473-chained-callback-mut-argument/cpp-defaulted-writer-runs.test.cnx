// test-execution
// test-cpp-only
// test-adr: 071
// Tests: a C++ overload set with a defaulted pointer writer and a by-value
// overload (#2473 review). Each argument is written for the first overload
// the call can reach, and the write checks judge that same overload:
// `p.put(passed, 2)` reaches the writer, so `passed` is written; `r.put(one)`
// reaches only the writer, so it is passed by its address.
#include "lib/cpp-pw.hpp"

mut Pw p;
mut Rv r;

u32 main() {
    mut i32 passed <- 0;
    p.put(passed, 2);
    if (passed != 42) {
        return 1;
    }
    mut i32 left <- 0;
    p.put(left);
    if (left != 40) {
        return 2;
    }
    mut i32 one <- 0;
    r.put(one);
    if (one != 40) {
        return 3;
    }
    return 0;
}
