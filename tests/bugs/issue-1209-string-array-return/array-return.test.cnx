// test-execution
// Issue #1209: a function returning an array fills a buffer the caller
// supplies, so a returned local is memory safe.

u8[4] table <- [5, 6, 7, 8];

u8[4] make() {
    u8[4] a <- [1, 2, 3, 4];
    return a;
}

u8[4] getTable() {
    return table;
}

u8[4] constant() {
    return [9, 8, 7, 6];
}

u32 main() {
    u8[4] a <- make();
    if (a[0] != 1) {
        return 1;
    }
    if (a[3] != 4) {
        return 2;
    }
    mut u8[4] b <- [0, 0, 0, 0];
    b <- getTable();
    if (b[0] != 5) {
        return 3;
    }
    if (b[3] != 8) {
        return 4;
    }
    u8[4] c <- constant();
    if (c[1] != 8) {
        return 5;
    }
    return 0;
}
