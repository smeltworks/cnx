// test-execution
// test-adr: 035
// Issue #1209 (ADR-035 clarification, 2026-11-13): an array is a value. Inside
// a function, another array of the same element type and shape -- a variable,
// a field, a call -- initializes or is assigned to an array, and is copied
// element by element.

struct H {
    u8[4] buf;
}

u8[4] source <- [1, 2, 3, 4];

u8[4] reversed(u8[4] p) {
    return [p[3], p[2], p[1], p[0]];
}

u32 main() {
    u8[4] copy <- source;
    if (copy[3] != 4) {
        return 1;
    }
    mut H h <- { buf: [0*] };
    h.buf <- source;
    if (h.buf[2] != 3) {
        return 2;
    }
    mut u8[2][4] grid <- [[0*], [0*]];
    grid[1] <- source;
    if (grid[1][0] != 1) {
        return 3;
    }
    string<8>[2] names <- ["a", "b"];
    mut string<8>[2] others <- ["c", "d"];
    others <- names;
    if (others[1] != "b") {
        return 4;
    }
    string<8>[2] namesCopy <- names;
    if (namesCopy[0] != "a") {
        return 5;
    }
    mut u8[4] flip <- source;
    flip <- reversed(flip);
    if (flip[0] != 4) {
        return 6;
    }
    if (flip[3] != 1) {
        return 7;
    }
    u8[4] fromField <- h.buf;
    if (fromField[1] != 2) {
        return 8;
    }
    return 0;
}
