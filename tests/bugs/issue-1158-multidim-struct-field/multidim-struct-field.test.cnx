// test-execution
// Issue #1158: a multi-dimensional struct field must keep every dimension.
//
// StructCollector.processArrayTypeSyntax() read only dims[0], so `u8[2][3]`
// was recorded as [2]. A non-empty list wins over the AST fallback in
// StructGenerator.generateRegularField() -- which resolves all dimensions
// correctly -- so both the .c and the .h emitted `uint8_t cells[2]` while the
// body still emitted `cells[1][2]`, and the output did not compile:
//   error: subscripted value is neither array nor pointer nor vector
//
// Top-level `u8[2][3] grid;` was always correct; only struct fields truncated.
//
// Reading the field back is checked too. That read used to generate
// `(g.cells[1] >> 2) & 1`, treating the second subscript as a bit index; it
// reads the element now, and #1114 made this fixture execute so a
// regression in either direction fails here rather than only in a snapshot.
struct Grid {
    u8[2][3] cells;
}

mut u8[2][3] topLevel;

i32 main() {
    mut Grid g;
    g.cells[1][2] <- 42;
    g.cells[0][0] <- 7;
    topLevel[1][2] <- 42;
    if (g.cells[1][2] != 42) {
        return 1;
    }
    if (g.cells[0][0] != 7) {
        return 2;
    }
    if (topLevel[1][2] != 42) {
        return 3;
    }
    u8 element <- g.cells[1][2];
    if (element != 42) {
        return 4;
    }
    bool bit <- g.cells[1][2][3];
    if (bit != true) {
        return 5;
    }
    return 0;
}
