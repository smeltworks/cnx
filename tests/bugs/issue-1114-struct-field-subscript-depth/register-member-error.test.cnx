// test-error
// test-adr: 007
#pragma target cortex-m7
// Issue #1114: a register member takes one bit index, like any scalar.
//
// NEGATIVE CONTROL: `GPIO.DR[3]`, the one bit index, stays silent.
register GpioPort {
    0x00 rw u32 DR,
}

GpioPort GPIO(0x40000000);

void writes() {
    GPIO.DR[3][1] <- true;
    GPIO.DR[3] <- true;
}
