// test-execution
// test-adr: 044
// #1790 review: a header macro divisor is not narrowed into the operand's type.
// A signed `/` and `%` call ADR-044's helper for MIN / -1, and a helper whose
// `b` was the operand type turned `BIG` (300) into 44 for an i8 and `HUGE`
// (3000000000) into -1294967296 for an i32. `b` is now the wider type, as for
// every helper (#94), and a divisor past the type is answered exactly.
#include "divisor_macros.h"

i8 quotient8(i8 a) {
    return a / BIG;
}

i8 remainder8(i8 a) {
    return a % BIG;
}

i8 compound8(i8 a) {
    mut i8 q <- a;
    q /<- BIG;
    return q;
}

i8 quotientPast8(i8 a) {
    return a / I8_PAST;
}

i8 remainderPast8(i8 a) {
    return a % I8_PAST;
}

i32 quotient32(i32 a) {
    return a / HUGE;
}

i32 remainder32(i32 a) {
    return a % HUGE;
}

i32 quotientPast32(i32 a) {
    return a / I32_PAST;
}

i32 remainderPast32(i32 a) {
    return a % I32_PAST;
}

i32 quotientMinusOne(i32 a) {
    return a / MINUS_ONE_LONG;
}

u32 main() {
    // 100 / 300 is 0, and 100 % 300 is 100
    i8 r1 <- quotient8(100);
    if (r1 != 0) {
        return 1;
    }
    i8 r2 <- remainder8(100);
    if (r2 != 100) {
        return 2;
    }
    i8 r3 <- compound8(100);
    if (r3 != 0) {
        return 3;
    }
    i8 r4 <- remainder8(-100);
    if (r4 != -100) {
        return 4;
    }
    // MIN by MAX + 1 is the one divisor past the type with a quotient: -1
    i8 r5 <- quotientPast8(-127 - 1);
    if (r5 != -1) {
        return 5;
    }
    i8 r6 <- remainderPast8(-127 - 1);
    if (r6 != 0) {
        return 6;
    }
    i8 r7 <- quotientPast8(127);
    if (r7 != 0) {
        return 7;
    }
    i8 r8 <- remainderPast8(127);
    if (r8 != 127) {
        return 8;
    }
    i32 r9 <- quotient32(2000000000);
    if (r9 != 0) {
        return 9;
    }
    i32 r10 <- remainder32(2000000000);
    if (r10 != 2000000000) {
        return 10;
    }
    i32 r11 <- quotientPast32(-2147483647 - 1);
    if (r11 != -1) {
        return 11;
    }
    i32 r12 <- remainderPast32(-2147483647 - 1);
    if (r12 != 0) {
        return 12;
    }
    i32 r13 <- remainderPast32(-2147483647);
    if (r13 != -2147483647) {
        return 13;
    }
    // A wide -1 is still MIN / -1: clamp gives MAX
    i32 r14 <- quotientMinusOne(-2147483647 - 1);
    if (r14 != 2147483647) {
        return 14;
    }
    i32 r15 <- quotientMinusOne(6);
    if (r15 != -6) {
        return 15;
    }
    return 0;
}
