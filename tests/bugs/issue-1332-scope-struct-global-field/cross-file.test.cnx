// test-execution
// Issue #1332, cross-file control: the global struct a scope struct uses is
// declared in an included file, and a global struct in this file uses the scope
// struct in turn. This compiled before the fix too -- the included header comes
// first -- and pins that moving scope structs into source order keeps it so.

#include "config-lib.cnx"

scope S {
    u32 other <- 5;

    public struct Holder {
        Config c;
    }
}

struct Top {
    S.Holder h;
}

u32 main() {
    S.Holder held <- { c: { x: 7 } };
    if (held.c.x != 7) {
        return 1;
    }

    Top t <- { h: { c: { x: 9 } } };
    if (t.h.c.x != 9) {
        return 2;
    }

    return 0;
}
