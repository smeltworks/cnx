// test-execution
// Issue #1332, cross-file: scope S is reopened (#1333) in this file, and the
// second block's struct uses a global struct declared above it here. Before the
// fix the header defined `S__H` ahead of `Config` ("unknown type name 'Config'").

#include "reopen-lib.cnx"

struct Config {
    u32 x;
}

scope S {
    public struct H {
        Config c;
        A a;
    }
}

u32 main() {
    S.H h <- { c: { x: 3 }, a: { x: 4 } };
    if (h.c.x != 3) {
        return 1;
    }
    if (h.a.x != 4) {
        return 2;
    }
    return 0;
}
