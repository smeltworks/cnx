// test-execution
// Issue #2373 review: a range write whose source is a range of the same
// string reads every source character before it writes any. Copying forward
// over itself, s[1, 3] <- s[0, 3], must leave "aabcefgh", not "aaaaefgh".
// Each result is checked with its own return code.

mut string<8> s;
mut string<8> b;

u32 main() {
    s <- "abcdefgh";
    s[1, 3] <- s[0, 3];
    b <- "abcdefgh";
    b[0, 3] <- b[1, 3];

    if (s[0] != 'a') {
        return 1;
    }
    if (s[1] != 'a') {
        return 2;
    }
    if (s[2] != 'b') {
        return 3;
    }
    if (s[3] != 'c') {
        return 4;
    }
    if (s[4] != 'e') {
        return 5;
    }
    if (b[0] != 'b') {
        return 6;
    }
    if (b[1] != 'c') {
        return 7;
    }
    if (b[2] != 'd') {
        return 8;
    }
    if (b[3] != 'd') {
        return 9;
    }
    return 0;
}
