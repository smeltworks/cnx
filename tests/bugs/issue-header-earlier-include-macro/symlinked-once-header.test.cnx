// test-execution
// lib/include-link/once-board.h links to lib/vendor/sdk/once-board.h, which
// has #pragma once, so the compile opens it only under its first spelling,
// after once-config.h. The second spelling is the same file and takes that
// reading: C, with 8 pins, not the class and 4 pins it holds alone.
#include "lib/once-config.h"
#include "lib/include-link/once-board.h"
#include "lib/vendor/sdk/once-board.h"

u32 main() {
    if (once_pins.type_element_count != 8) {
        return 1;
    }
    return 0;
}
