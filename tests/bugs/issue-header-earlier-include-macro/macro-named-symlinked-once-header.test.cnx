// test-execution
// lib/once-board-by-macro.h opens lib/include-link/once-board.h through a
// macro, ONCE_BOARD_HEADER. That spelling links to
// lib/vendor/sdk/once-board.h, which has #pragma once, so the compile opens it
// only there, after once-config.h. The literal spelling below is the same
// file and takes that reading: 8 pins, not the class and 4 pins it holds alone.
#include "lib/once-config.h"
#include "lib/once-board-by-macro.h"
#include "lib/vendor/sdk/once-board.h"

mut u8[once_pins.type_element_count] copy;

u32 main() {
    if (copy.type_element_count != 8) {
        return 1;
    }
    return 0;
}
