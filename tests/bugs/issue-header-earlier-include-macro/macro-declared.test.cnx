// test-execution
// declared-use.h has no conditional: an earlier include's macro writes its
// declaration, so C reads `extern uint8_t declared[5];`, and so must cnx.
// no-cpp-config.h sets NO_CPP_API, so C reads nothing of cpp-api.h, and the
// C++ class it would declare does not make this a C++ run.
#include "lib/declare-macro.h"
#include "lib/declared-use.h"
#include "lib/no-cpp-config.h"
#include "lib/cpp-api.h"

mut u8[declared.type_element_count] copy;

u32 main() {
    if (copy.type_element_count != 5) {
        return 1;
    }
    return 0;
}
