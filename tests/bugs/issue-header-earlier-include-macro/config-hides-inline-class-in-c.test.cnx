// test-cpp-only
// test-execution
// c-only-api-config.h hides InlineCounter from C alone. A C++ build reads
// inline-counter-in-cpp.h as g++ does, and its class's access label shares a
// line with the brace, so it is still C++, and data still has 4 elements.
#include "lib/c-only-api-config.h"
#include "lib/inline-counter-in-cpp.h"

u32 main() {
    u32 n <- inlineCounter.data.type_element_count;
    if (n != 4) {
        return 1;
    }
    return 0;
}
