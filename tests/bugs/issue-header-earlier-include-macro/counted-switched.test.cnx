// test-execution
// sensor-config.h switches counted-buffer.h's wide_samples branch, so the header is read from the unit.
// table's bound SENSOR_COUNT folds through the header's own macro to 3, as C reads it (#2510).
#include "lib/sensor-config.h"
#include "lib/counted-buffer.h"

mut u8[table.type_element_count] copy;

i32 main() {
    copy[0] <- 1;
    if (copy.type_element_count != 3) {
        return 1;
    }
    return 0;
}
