// test-execution
// c-only-api-config.h sets NO_CPP_API_IN_C only when __cplusplus is not defined,
// so C reads nothing of cpp-api-in-cpp.h. A header's language is judged on
// the text C meets (#1542 ruling 4), so the class it declares under C++ does
// not make this a C++ run.
#include "lib/c-only-api-config.h"
#include "lib/cpp-api-in-cpp.h"

mut u8 seen <- 1;

u32 main() {
    if (seen != 1) {
        return 1;
    }
    return 0;
}
