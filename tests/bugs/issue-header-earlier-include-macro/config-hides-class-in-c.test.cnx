// test-cpp-only
// test-execution
// c-only-api-config.h hides HiddenCounter from C alone. A C++ build reads
// counter-in-cpp.h as g++ does, class and constructor included, so the
// initializer goes through the constructor, not a designated initializer.
#include "lib/c-only-api-config.h"
#include "lib/counter-in-cpp.h"

i32 main() {
    HiddenCounter counter <- { value: 42 };
    if (counter.value != 42) {
        return 1;
    }
    return 0;
}
