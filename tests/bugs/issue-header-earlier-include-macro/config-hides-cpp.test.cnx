// test-execution
// no-cpp-config.h sets NO_CPP_API, so C reads nothing of cpp-api.h, and the
// C++ class it would declare does not make this a C++ run.
#include "lib/no-cpp-config.h"
#include "lib/cpp-api.h"

mut u8 seen <- 1;

u32 main() {
    if (seen != 1) {
        return 1;
    }
    return 0;
}
