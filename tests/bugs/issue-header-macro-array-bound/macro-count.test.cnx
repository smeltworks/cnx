// test-execution
// A header array sized by a header macro has the count C reads: table is
// SENSOR_COUNT (3), pairs (SENSOR_COUNT * 2) (6), and frame.data
// SENSOR_COUNT + 1 (4). Each sizes a cnx array, and table's last element is
// written through a constant index. duo and duo_bits_t.two read PAIR_COUNT,
// a macro named like a struct tag, which sizes nothing: 2. typed is a
// buf_t, an array typedef of SENSOR_COUNT (3); kinds reads KIND_COUNT, a macro
// named like an enum tag: 2.
#include "lib/counted.h"

mut u8[table.type_element_count] tableCopy;
mut u8[pairs.type_element_count] pairsCopy;
mut u8[frame.data.type_element_count] dataCopy;
mut u8[duo.type_element_count] duoCopy;
mut duo_bits_t bits;
mut u8[typed.type_element_count] typedCopy;
mut u8[typed.type_byte_length] typedBytes;
mut u8[kinds.type_element_count] kindsCopy;

u32 main() {
    if (tableCopy.type_element_count != 3) {
        return 1;
    }
    if (pairsCopy.type_element_count != 6) {
        return 2;
    }
    if (dataCopy.type_element_count != 4) {
        return 3;
    }
    table[2] <- 7;
    if (table[2] != 7) {
        return 4;
    }
    if (duoCopy.type_element_count != 2) {
        return 5;
    }
    bits.two <- 3;
    if (bits.two != 3) {
        return 6;
    }
    if (typedCopy.type_element_count != 3) {
        return 7;
    }
    if (typedBytes.type_element_count != 3) {
        return 20;
    }
    if (kindsCopy.type_element_count != 2) {
        return 8;
    }
    return 0;
}
