// test-error
// test-cpp-only
// Each data is sized by a name its base class declares as an enum constant
// of 3: Limits, the class template TLimits<3>, the nested class Outer::Inner.
// g++ reads each as 3 though the .hpp then defines a macro of 8, so cnx
// folds none of them (macro-count-base-plain: a base that declares nothing).
#include "lib/based.hpp"

mut u8[based.data.type_element_count] copy;
mut u8[tbased.data.type_element_count] tcopy;
mut u8[ibased.data.type_element_count] icopy;

void main() {
    copy[0] <- 1;
    tcopy[0] <- 1;
    icopy[0] <- 1;
}
