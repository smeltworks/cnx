// test-error
// test-adr: 071
// Issue #2474 control: lib/plain-user.cnx's header declares a plain state,
// and main includes volatile-state.h itself, so main's state is volatile,
// and a mut parameter may not take it.
#include "lib/plain-user.cnx"
#include "lib/volatile-state.h"

void bump(mut u32 n) {
    n <- n + 1;
}

u32 main() {
    bump(state);
    return plainState();
}
