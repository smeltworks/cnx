// test-error
// Issue #2474 review: the index check reads the bound C composes from a
// header's redeclarations, the same 4 a length property reads, whichever
// declaration is sized. Neither array has an element 6.
#include "lib/redeclared-array.h"

u8 readBoth() {
    u8 s <- samples[6];
    u8 r <- readings[6];
    return s + r;
}

void main() {
    (void)readBoth();
}
