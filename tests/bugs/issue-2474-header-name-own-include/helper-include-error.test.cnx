// test-error
// Issue #2474: main includes plain-state.h, so the build reads its plain
// state first. lib/volatile-bump.cnx includes volatile-state.h itself, so
// its state is volatile, and passing it to a mut parameter is an error there.
// It used to be accepted, and the volatile access was lost.
#include "lib/plain-state.h"
#include "lib/volatile-bump.cnx"

u32 main() {
    bumpVolatile();
    return state;
}
