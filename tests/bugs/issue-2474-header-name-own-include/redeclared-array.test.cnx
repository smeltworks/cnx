// Issue #2474 review: a header declares readings sized, then unsized, so its
// element count is 4. samples, declared unsized first, is
// redeclared-array-bound's; its type's spelling needs no size.
#include "lib/redeclared-array.h"

u32 readingCount() {
    u32 n <- readings.type_element_count;
    return n;
}

u32 sampleChars() {
    u32 c <- samples.type_char_count;
    return c;
}

void main() {
    (void)readingCount();
    (void)sampleChars();
}
