// test-execution
// Issue #2474 review: a-types.h and b-types.h both typedef sample_t, as u8
// and u32. lib/types-b.cnx's generated header includes only b-types.h, the
// header it reads sample_t from. It used to include a-types.h too, because
// that header came first in the run, and C rejected the conflicting typedefs.
#include "lib/types-a.cnx"
#include "lib/types-b.cnx"

u32 main() {
    u8 a <- readA();
    if (a != 200) {
        return 1;
    }
    u32 b <- passB(70000);
    if (b != 70000) {
        return 2;
    }
    return 0;
}
