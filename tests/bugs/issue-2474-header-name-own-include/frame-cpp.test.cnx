// test-cpp-only
// test-execution
// Issue #2474 review: a-frame.hpp's C++ Frame holds 4 bytes and
// b-frame.hpp's 8. Each helper reads its own header's frame.data, with
// lib/frame-cpp-a.cnx discovered first.
#include "lib/frame-cpp-a.cnx"
#include "lib/frame-cpp-b.cnx"

u32 main() {
    u32 a <- aFrameCppCount();
    if (a != 4) {
        return 1;
    }
    u32 b <- bFrameCppCount();
    if (b != 8) {
        return 2;
    }
    return 0;
}
