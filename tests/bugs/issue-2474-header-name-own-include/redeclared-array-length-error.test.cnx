// test-error
// Issue #2474 review: samples is declared unsized first, so its bit and byte
// lengths are not known either. They used to render an empty `()`.
#include "lib/redeclared-array.h"

u32 sampleBits() {
    u32 bits <- samples.type_bit_length;
    return bits;
}

u32 sampleBytes() {
    u32 bytes <- samples.type_byte_length;
    return bytes;
}

void main() {
    (void)sampleBits();
    (void)sampleBytes();
}
