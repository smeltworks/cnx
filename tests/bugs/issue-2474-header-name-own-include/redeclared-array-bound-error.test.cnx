// test-error
// Issue #2474 review: samples is first declared without a size, then sized 4.
// Which size the compiler reads can depend on an earlier include's macro, and
// until cnx reads the header as the compiler does (#2504) it cannot tell, so
// an array sized by samples.type_element_count is E0867, not a guess of 4.
#include "lib/redeclared-array.h"

mut u8[samples.type_element_count] copy;

u32 main() {
    copy[0] <- 1;
    return copy.type_element_count;
}
