// test-execution
// Issue #1958 negative control: with no write between the reads, the two
// length reads share one cached strlen. Writing a non-local number cannot
// change a string, so it keeps a non-local string's cache.

string<8> title <- "ab";
mut u32 ticks <- 0;

u32 tick() {
    if (title.value_char_count = 2) {
        ticks <- 1;
        u32 n <- title.value_char_count;
        if (n != 2) {
            return 2;
        }
    }
    return 0;
}

u32 main() {
    string<8> label <- "ab";
    if (label.value_char_count = 2) {
        u32 n <- label.value_char_count;
        if (n != 2) {
            return 1;
        }
    }
    return tick();
}
