// test-transpile-only
// widget_t is declared in widget_types.h and completed in widget_private.h,
// which fake_lib.h includes. A header's names are visible only in a file
// that includes it itself (#1881), so this file includes both.
#include "fake_lib.h"
#include "widget_types.h"
#include "widget_private.h"

scope App {
    widget_t root;

    void on_change(mut widget_t w) {
        i32 val <- global.widget_get_value(w);
    }

    public void init() {
        mut widget_t child <- global.widget_create();
        global.widget_set_callback(child, this.on_change);
    }
}
