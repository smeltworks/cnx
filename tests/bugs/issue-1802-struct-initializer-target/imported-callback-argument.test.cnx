// test-error
// #1984 review: an ADR-029 function type is not a struct, also when only an
// included file writes it. `runTick` takes a `tick`, and this file never
// spells that type itself, so the struct initializer passed to it is still
// E0358 rather than C a compiler rejects.
#include "callback-api.cnx"

u32 main() {
    runTick({ a: 1 });
    return 0;
}
