// test-execution
// #2348 review: a ternary built in branches, because one arm passes a built
// string to a C call, holds the wider of its arms as C's ?: would. Held in
// strcmp's int32_t, big's 5000000000 lost its high bits before the compare.
#pragma target host
#include <string.h>

string<8> s <- "abc";
i64 big <- 5000000000;

u32 main() {
    u32 pick <- 0;
    bool wide <- ((pick = 1) ? strcmp(s + "!", "x") : big) > 4000000000;
    if (wide != true) {
        return 1;
    }
    bool built <- ((pick = 0) ? strcmp(s + "!", "abc!") : big) = 0;
    if (built != true) {
        return 2;
    }
    return 0;
}
