// test-error
// test-adr: 045
// #2348 review: a string built for a C char pointer parameter lives only as
// long as its block, so passing one to a C function that returns a pointer,
// which may point into it, is E0948.
#include <string.h>

string<8> s <- "abc";
mut i32 order;

scope Finder {
    public void find() {
        // ASSERTION -- scope method
        cstring c_in <- strstr(s + "x", "a");
    }
}

void main() {
    cstring c_at <- strstr(s + "de", "cd");
    cstring c_ch <- strchr(s[0, 2], 'b');
    // Control: strcmp returns no pointer, and s passed whole is not built
    order <- strcmp(s + "d", "abcd");
    cstring c_whole <- strstr(s, "b");
}
