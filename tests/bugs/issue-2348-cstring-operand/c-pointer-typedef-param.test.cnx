// test-execution
// #2348 review: a string is built for every C parameter that points to char,
// however it is spelled: a typedef of const char*, or a char array parameter,
// which C passes as a pointer. Before, each got 's + s[0]' as C pointer
// arithmetic, and read the wrong length.
#pragma target host
#include "lib/text-length.h"

string<8> s <- "hello";

u32 main() {
    u32 viewed <- view_length(s + s[0]);
    if (viewed != 6) {
        return 1;
    }
    u32 arrayed <- array_length(s + s[0]);
    if (arrayed != 6) {
        return 2;
    }
    u32 part <- view_length(s[1, 3]);
    if (part != 3) {
        return 3;
    }
    return 0;
}
