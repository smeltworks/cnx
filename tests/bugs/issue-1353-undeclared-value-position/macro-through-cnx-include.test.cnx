// test-adr: 030
// test-error
// #1881: a header's names are visible only in a file that includes it itself.
//
// Both names come from a C header two hops away: this file includes only a
// .cnx, and that file includes the header. The #1399 review made the
// exemption transitive, so both were accepted. Neither is defined here: the
// typedef is E0426, the macro E0427.
#include <macro-bridge.cnx>

shared_point_t sharedOrigin;

u32 main() {
    u32 limit <- SHARED_LIMIT_MACRO;
    if (limit != 42) {
        return 1;
    }
    return 0;
}
