// test-execution
// test-adr: 072
// #2117 (owner ruling 2026-11-12): a scanf-family call with a literal format
// decides from that format which arguments it writes. `%d` writes argument 3,
// so `parsed` is passed by address and is written. CONTROL: `printf` takes
// the same `mut` binding by value.
#include <stdio.h>

scope Reader {
    public u16 read() {
        mut u16 value <- 0;
        i32 count <- global.sscanf("40 2", "%hu %*d", value);
        if (count != 1) {
            return 0;
        }
        return value;
    }
}

i32 main() {
    mut i32 parsed <- 0;
    i32 count <- global.sscanf("7", "%d", parsed);
    if (count != 1) {
        return 1;
    }
    if (parsed != 7) {
        return 2;
    }
    i32 printed <- global.printf("%d\n", parsed);
    if (printed != 2) {
        return 3;
    }
    // A scope method's binding, a length modifier and a suppressed conversion
    u16 read <- Reader.read();
    if (read != 40) {
        return 4;
    }
    return 0;
}
