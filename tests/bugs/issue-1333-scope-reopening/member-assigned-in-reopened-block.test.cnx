// test-execution
// test-adr: 016
// Issue #2115: a scope member is initialized when ANY of the scope's functions
// assigns it, whichever block of a reopened scope that function is written in.
//
// A bare name resolves against the whole scope, not the block (ADR-016), so
// `counter` read in the first block is the one `set` assigns in the second.
// Before #2115 the check looked only at the declaring block's functions and
// reported E0381 here.

scope Lib {
    mut u32 counter;
    public u32 read() {
        return counter;
    }
}

scope Lib {
    public void set() {
        counter <- 5;
    }
}

u32 main() {
    Lib.set();
    u32 value <- Lib.read();
    if (value != 5) {
        return 1;
    }
    return 0;
}
