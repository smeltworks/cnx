// test-execution
// test-no-warnings
// test-adr: 045
// Tests: #1955 - ADR-045's Substring Concatenation example, a[0, 16] + b[16, 16], copies the first half of a and the second half of b, in a declaration and in an assignment; distinct characters show each part is taken from its own start and stops at its own length
u32 main() {
    string<32> a <- "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
    string<32> b <- "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB";

    string<32> result <- a[0, 16] + b[16, 16];
    if (result != "AAAAAAAAAAAAAAAABBBBBBBBBBBBBBBB") {
        return 1;
    }
    if (result.value_char_count != 32) {
        return 2;
    }

    mut string<32> assigned <- "x";
    assigned <- a[0, 16] + b[16, 16];
    if (assigned != "AAAAAAAAAAAAAAAABBBBBBBBBBBBBBBB") {
        return 3;
    }
    if (assigned.value_char_count != 32) {
        return 4;
    }

    string<16> letters <- "abcdefghijklmnop";
    string<16> picked <- letters[4, 4] + letters[10, 3];
    if (picked != "efghklm") {
        return 5;
    }
    if (picked.value_char_count != 7) {
        return 6;
    }

    mut string<16> repicked <- "x";
    repicked <- letters[10, 3] + letters[4, 4];
    if (repicked != "klmefgh") {
        return 7;
    }
    if (repicked.value_char_count != 7) {
        return 8;
    }

    return 0;
}
