// test-execution
// test-adr: 025, 057
// #2075: a local `LIMIT` shadows the file's, and `global.LIMIT` reaches past
// it. They are two consts with two values, 5 and 1, so the two labels are two
// C cases and E0713 stays silent. The local label is written as its value,
// an integer constant C switches on (#2493).
u8 LIMIT <- 1;

u32 shadowed(u8 s) {
    u8 LIMIT <- 5;
    switch (s) {
        case LIMIT {
            return 1;
        }
        case global.LIMIT {
            return 2;
        }
        default {
            return 0;
        }
    }
    return 0;
}

u32 main() {
    mut u32 got <- shadowed(5);
    if (got != 1) {
        return 1;
    }
    got <- shadowed(1);
    if (got != 2) {
        return 2;
    }
    got <- shadowed(3);
    if (got != 0) {
        return 3;
    }
    return 0;
}
