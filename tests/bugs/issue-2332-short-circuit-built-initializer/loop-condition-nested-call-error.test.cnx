// test-error
// Tests: #2332 - E0702 admits no call anywhere in a loop condition: a call inside a subscript (here one building a struct initializer) is a call in the condition, in while, do-while and for alike
struct Named {
    string<8> s;
    u32 n;
}

u32 w(Named x) {
    return x.n;
}

u32 main() {
    string<8> t <- "hi";
    u32[2] arr <- [0, 1];

    mut u32 i <- 0;
    while ((i < 3) && (arr[w({ s: t, n: 1 })] = 1)) {
        i <- i + 1;
    }

    mut u32 d <- 0;
    do {
        d <- d + 1;
    } while ((d < 3) && (arr[w({ s: t, n: 1 })] = 1));

    for (mut u32 j <- 0; (j < 3) && (arr[w({ s: t, n: 1 })] = 1); j <- j + 1) {
        i <- i + 1;
    }
    return i;
}
