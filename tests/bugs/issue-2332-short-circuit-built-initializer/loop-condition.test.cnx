// test-execution
// test-target-xfail: atmega328p #1709 "Float bit indexing requires 64-bit double"
// test-no-warnings
// Tests: #2332 - only an operand holding a struct initializer built before its statement is lowered: a float bit read on the right of && in a while condition stays in the condition, so the loop still ends
u32 main() {
    mut u32 i <- 0;
    f32 x <- 1.5;
    while ((i < 3) && (x[0, 8] = 0)) {
        i <- i + 1;
    }
    if (i != 3) {
        return 1;
    }
    return 0;
}
