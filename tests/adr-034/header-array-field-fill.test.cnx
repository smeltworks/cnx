// test-execution
// test-adr: 035
// #2484 review: a header struct's array field takes a fill-all for its whole
// size, and a short list C zero-fills.
#include "header-bit-field.h"

u32 main() {
    CBank bank <- { data: [7*] };
    if (bank.data[0] != 7) {
        return 1;
    }
    if (bank.data[3] != 7) {
        return 2;
    }
    CBank partial <- { data: [1, 2] };
    if (partial.data[1] != 2) {
        return 3;
    }
    if (partial.data[3] != 0) {
        return 4;
    }
    return 0;
}
