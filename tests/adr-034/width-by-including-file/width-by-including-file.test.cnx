// test-execution
// test-adr: 034
// #2484 review: a bit-field's width is read through the macros of the files
// that include its header. side.cnx defines W as 5 through other.h but never
// includes hw.h, so its W is not the one C read `a : W` by: `a` is 3 bits,
// and a write that fits them is accepted.
#include "hw.h"
#include "side.cnx"

u32 main() {
    mut HwReg r <- { a: 0 };
    r.a <- 7;
    if (r.a != 7) {
        return 1;
    }
    return 0;
}
