// test-error
// test-adr: 034
// ADR-072 ruling 19: a C header struct's bit-field takes a bitmap field's
// rules. A known value is judged against the bits the field declares, not its
// C type: `unsigned int mode : 3` holds 0 through 7, and C would keep only the
// low 3 bits of 13. A signed bit-field holds -4 through 3. A `uint_fast8_t`
// bit-field's arithmetic has no known width, so its constant is folded whole
// and judged by the 3 bits. A `{ field: value }` initializer is judged the
// same, an element of a header array field included; a short list for a
// header array field is C's, which zero-fills the rest.

#include "header-bit-field.h"

mut CReg r;

void main() {
    // NEGATIVE CONTROLS -- each stays silent.
    r.mode <- 7;
    r.level <- 3;
    r.level <- -4;
    r.flag <- 1;
    r.count <- 13;
    r.fast <- 256 >> 8;
    CReg built <- { mode: 7, level: -4 };
    CBank partial <- { regs: [{ mode: 7 }], data: [1, 2] };

    // ASSERTIONS
    r.mode <- 13;
    r.level <- 4;
    r.level <- -5;
    r.flag <- 2;
    r.fast <- 0xFFFFFFFF + 1;
    CReg init <- { mode: 13 };
    COuter outer <- { reg: { level: 4 }, tag: 1 };
    CBank bank <- { regs: [{ mode: 1 }, { mode: 13 }] };
}
