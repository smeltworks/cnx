// test-coverage: 32.4-variable-init, 32.4-array-element, 32.4-comparison, 32.4-in-switch-case
// test-execution
// Tests: Character literal usage in various contexts
// Character literals work with u8 type (which maps to uint8_t in C)
u32 main() {
    // ===== Variable initialization =====

    // Test basic char literal to u8
    u8 letter <- (u8)'A';
    if (letter != 65) {
        return 1;
    }

    // Test lowercase
    u8 lower <- (u8)'z';
    if (lower != 122) {
        return 2;
    }

    // Test digit character
    u8 digit <- (u8)'0';
    if (digit != 48) {
        return 3;
    }

    // Test space character
    u8 space <- (u8)' ';
    if (space != 32) {
        return 4;
    }

    // ===== Comparison operations =====

    // Test equality comparison
    u8 c <- (u8)'X';
    if (c != (u8)'X') {
        return 5;
    }

    // Test not-equal comparison
    if (c = (u8)'Y') {
        return 6;
    }

    // Test less-than comparison (ASCII ordering)
    if ('A' >= 'B') {
        return 7;
    }

    // Test greater-than comparison
    if ('Z' <= 'A') {
        return 8;
    }

    // Test comparison with variable
    u8 first <- (u8)'a';
    u8 second <- (u8)'b';
    if (first >= second) {
        return 9;
    }

    // ===== Array element context =====

    // Test char literals in array initializer
    u8[5] vowels <- [(u8)'a', (u8)'e', (u8)'i', (u8)'o', (u8)'u'];
    if (vowels[0] != (u8)'a') {
        return 10;
    }
    if (vowels[1] != (u8)'e') {
        return 11;
    }
    if (vowels[2] != (u8)'i') {
        return 12;
    }
    if (vowels[3] != (u8)'o') {
        return 13;
    }
    if (vowels[4] != (u8)'u') {
        return 14;
    }

    // Test array element assignment with char literal
    mut u8[4] buffer;
    buffer[0] <- (u8)'H';
    buffer[1] <- (u8)'i';
    buffer[2] <- (u8)'!';
    buffer[3] <- 0;
    if (buffer[0] != 72) {
        return 15; // 'H' = 72
    }
    if (buffer[1] != 105) {
        return 16; // 'i' = 105
    }
    if (buffer[2] != 33) {
        return 17; // '!' = 33
    }

    // ===== Switch case context =====

    // Test switch with char literal cases
    u8 grade <- (u8)'B';
    mut u32 points <- 0;

    switch (grade) {
        case 'A' {
            points <- 4;
        }
        case 'B' {
            points <- 3;
        }
        case 'C' {
            points <- 2;
        }
        default {
            points <- 0;
        }
    }
    if (points != 3) {
        return 18;
    }

    // Test another switch case
    mut u8 dir <- (u8)'N';
    mut u32 heading <- 0;

    switch (dir) {
        case 'N' {
            heading <- 0;
        }
        case 'E' {
            heading <- 90;
        }
        case 'S' {
            heading <- 180;
        }
        case 'W' {
            heading <- 270;
        }
        default {
            heading <- 999;
        }
    }
    if (heading != 0) {
        return 19;
    }

    // Test switch with 'S' direction
    dir <- (u8)'S';
    switch (dir) {
        case 'N' {
            heading <- 0;
        }
        case 'E' {
            heading <- 90;
        }
        case 'S' {
            heading <- 180;
        }
        case 'W' {
            heading <- 270;
        }
        default {
            heading <- 999;
        }
    }
    if (heading != 180) {
        return 20;
    }

    // ===== Arithmetic with char literals =====

    // Test addition (useful for case conversion)
    u8 upperA <- (u8)'A';
    u8 lowerA <- upperA + 32; // Convert to lowercase
    if (lowerA != (u8)'a') {
        return 21;
    }

    // Test subtraction
    u8 lowerZ <- (u8)'z';
    u8 upperZ <- lowerZ - 32; // Convert to uppercase
    if (upperZ != (u8)'Z') {
        return 22;
    }

    return 0; // All tests passed
}
