{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/start-issue-assign-reminder.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for a start-work issue reference"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "github-triage@trailofbits": true
  }
}
