// references.cnx - Demonstrates simplified reference model (ADR-006)
// All parameters pass by reference, assignment updates values

#include <stdint.h>
#include <stdbool.h>

scope Console {
    void printInt(i32 value) {
        // Print implementation...
    }

    void printHex(u32 value) {
        // Print hex implementation...
    }
}

// Function that modifies its parameter
// No * or & needed - parameters always receive the address
void increment(mut i32 x) {
    x <- x + 1; // Updates the original variable
}

// Swap function - clean and simple
void swap(mut i32 a, mut i32 b) {
    i32 temp <- a;
    a <- b;
    b <- temp;
}

// Calculate with multiple "output" parameters
// Input params are read-only; output params are declared mut
void divmod(i32 dividend, i32 divisor, mut i32 quotient, mut i32 remainder) {
    quotient <- dividend / divisor;
    remainder <- dividend % divisor;
}

// Process an array (arrays naturally pass by reference). Array parameters must
// have an explicit size; the element count comes from the array itself.
void zeroArray(mut u8[16] buffer) {
    mut u32 i <- 0;
    while (i < buffer.type_element_count) {
        buffer[i] <- 0;
        i <- i + 1;
    }
}

// Struct example (ADR-014)
struct Point {
    i32 x;
    i32 y;
}

// Move a point (struct passes by reference)
void movePoint(mut Point p, i32 dx, i32 dy) {
    p.x <- p.x + dx;
    p.y <- p.y + dy;
}

// Configuration constants (ADR-006: no magic numbers in function calls)
i32 INITIAL_COUNTER <- 5;
i32 INITIAL_X <- 10;
i32 INITIAL_Y <- 20;
i32 DIVIDEND <- 17;
i32 DIVISOR <- 5;
i32 MOVE_DX <- 5;
i32 MOVE_DY <- 10;

// Main demonstration
void main() {
    // Simple increment
    mut i32 counter <- INITIAL_COUNTER;
    increment(counter);
    Console.printInt(counter); // Prints 6

    // Swap
    mut i32 x <- INITIAL_X;
    mut i32 y <- INITIAL_Y;
    swap(x, y);
    Console.printInt(x); // Prints 20
    Console.printInt(y); // Prints 10

    // Multiple outputs
    mut i32 q;
    mut i32 r;
    divmod(DIVIDEND, DIVISOR, q, r);
    Console.printInt(q); // Prints 3
    Console.printInt(r); // Prints 2

    // Array
    mut u8[16] data;
    zeroArray(data);

    // Point with struct initializer (ADR-014 - inferred type)
    Point origin <- { x: 0, y: 0 };
    Console.printInt(origin.x); // Prints 0

    // Point with zero initialization (ADR-015)
    mut Point cursor; // Zero-initialized: cursor.x = 0, cursor.y = 0
    movePoint(cursor, MOVE_DX, MOVE_DY);
    Console.printInt(cursor.x); // Prints 5
    Console.printInt(cursor.y); // Prints 10
}
